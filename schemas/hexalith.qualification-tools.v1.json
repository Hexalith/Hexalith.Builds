{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.com/schemas/hexalith.qualification-tools.v1.json",
  "title": "Isolated official qualification tools",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifacts"],
  "properties": {
    "schema": {"const": "hexalith.qualification-tools.v1"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/artifact"},
      "description": "Names must also be unique; the strict reader checks this before downloading."
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "sha256", "size", "format"],
      "properties": {
        "name": {"allOf": [{"$ref": "#/$defs/name"}, {"not": {"const": "receipt.json"}}]},
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/(?:dapr/(?:dapr|cli)|kubernetes-sigs/kind|kubernetes/kubernetes)/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+/[A-Za-z0-9_.-]+(?![\\s\\S])"
        },
        "sha256": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "format": {"enum": ["file", "binary", "tar.gz"]},
        "member": {"$ref": "#/$defs/name"},
        "binarySha256": {"$ref": "#/$defs/digest"}
      },
      "if": {"properties": {"format": {"const": "tar.gz"}}, "required": ["format"]},
      "then": {"required": ["member", "binarySha256"]},
      "else": {"not": {"anyOf": [{"required": ["member"]}, {"required": ["binarySha256"]}]}}
    }
  }
}
