{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.dev/schemas/hexalith.runtime-toolchain-evidence.v2.json",
  "title": "Hexalith current G-6 runtime and toolchain evidence v2",
  "description": "Current pending or accepted evidence; semantic validation binds full source closure, actual outcomes, package inventory, cleanup and a named decision on the reviewed packet hash. Historical v1 is unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acceptance",
    "approval",
    "artifacts",
    "baseline",
    "capturedUtc",
    "closure",
    "containment",
    "observedVersions",
    "repositories",
    "rollback",
    "schema",
    "status",
    "technicalValidity",
    "testCounts",
    "usableAsPrerequisite"
  ],
  "properties": {
    "schema": {
      "const": "hexalith.runtime-toolchain-evidence.v2"
    },
    "baseline": {
      "$ref": "#/$defs/pathHash"
    },
    "capturedUtc": {
      "type": "string",
      "format": "date-time"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "revision",
          "rootGitlink",
          "dirty"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "$ref": "#/$defs/gitRevision"
          },
          "rootGitlink": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/gitRevision"
              }
            ]
          },
          "dirty": {
            "type": "boolean"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "apphost-outcomes"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "attempts"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "baseline-governance"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "central-catalog"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "cleanup"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "command-record"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "consumer-audit"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "current-mutation-tests"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "current-validator"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "eventstore-capture-validation"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "eventstore-observations"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "eventstore-qualification-results"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "eventstore-support-results"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "evidence-schema"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "evidence-validator"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "limitations"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "mutation-tests"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "observed-versions"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "qualification-runner"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "resolved-packages"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "source-state"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "fixture-diagnostics"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "observedVersions": {
      "$ref": "#/$defs/tuple"
    },
    "testCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualification",
        "support"
      ],
      "properties": {
        "qualification": {
          "$ref": "#/$defs/counts"
        },
        "support": {
          "$ref": "#/$defs/counts"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvedBy",
        "approvedOn",
        "ownerRoles",
        "supportTableListed",
        "decision"
      ],
      "properties": {
        "approvedBy": {
          "enum": [
            "Jérôme Piquot"
          ]
        },
        "approvedOn": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "ownerRoles": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Builds",
              "Platform",
              "FrontComposer/Web"
            ]
          }
        },
        "supportTableListed": {
          "type": "boolean"
        },
        "decision": {
          "enum": [
            "approved",
            "approved-explicit-exception"
          ]
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiresDomainDataMutation",
        "action"
      ],
      "properties": {
        "requiresDomainDataMutation": {
          "const": false
        },
        "action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "containment": {
      "$ref": "#/$defs/containment"
    },
    "status": {
      "enum": [
        "pending",
        "accepted"
      ]
    },
    "technicalValidity": {
      "type": "boolean"
    },
    "usableAsPrerequisite": {
      "type": "boolean"
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "committed",
        "sourceManifestSha256"
      ],
      "properties": {
        "committed": {
          "type": "boolean"
        },
        "sourceManifestSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "acceptance": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approvedBy",
            "approvedAtUtc",
            "decision",
            "reviewedPacketSha256"
          ],
          "properties": {
            "approvedBy": {
              "enum": [
                "Jérôme Piquot"
              ]
            },
            "approvedAtUtc": {
              "type": "string",
              "format": "date-time"
            },
            "decision": {
              "const": "accept"
            },
            "reviewedPacketSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z][0-9A-Za-z.-]*)?$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "apphost-outcomes",
            "attempts",
            "baseline-governance",
            "central-catalog",
            "cleanup",
            "command-record",
            "consumer-audit",
            "current-mutation-tests",
            "current-validator",
            "eventstore-capture-validation",
            "eventstore-observations",
            "eventstore-qualification-results",
            "eventstore-support-results",
            "evidence-schema",
            "evidence-validator",
            "limitations",
            "mutation-tests",
            "observed-versions",
            "qualification-runner",
            "resolved-packages",
            "source-state",
            "fixture-diagnostics"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source-state": {
      "properties": {
        "kind": {
          "const": "source-state"
        }
      },
      "required": [
        "kind"
      ]
    },
    "baseline-governance": {
      "properties": {
        "kind": {
          "const": "baseline-governance"
        }
      },
      "required": [
        "kind"
      ]
    },
    "evidence-schema": {
      "properties": {
        "kind": {
          "const": "evidence-schema"
        }
      },
      "required": [
        "kind"
      ]
    },
    "evidence-validator": {
      "properties": {
        "kind": {
          "const": "evidence-validator"
        }
      },
      "required": [
        "kind"
      ]
    },
    "mutation-tests": {
      "properties": {
        "kind": {
          "const": "mutation-tests"
        }
      },
      "required": [
        "kind"
      ]
    },
    "central-catalog": {
      "properties": {
        "kind": {
          "const": "central-catalog"
        }
      },
      "required": [
        "kind"
      ]
    },
    "observed-versions": {
      "properties": {
        "kind": {
          "const": "observed-versions"
        }
      },
      "required": [
        "kind"
      ]
    },
    "command-record": {
      "properties": {
        "kind": {
          "const": "command-record"
        }
      },
      "required": [
        "kind"
      ]
    },
    "dispositions": {
      "properties": {
        "kind": {
          "const": "dispositions"
        }
      },
      "required": [
        "kind"
      ]
    },
    "eventstore-observations": {
      "properties": {
        "kind": {
          "const": "eventstore-observations"
        }
      },
      "required": [
        "kind"
      ]
    },
    "eventstore-qualification-results": {
      "properties": {
        "kind": {
          "const": "eventstore-qualification-results"
        }
      },
      "required": [
        "kind"
      ]
    },
    "eventstore-support-results": {
      "properties": {
        "kind": {
          "const": "eventstore-support-results"
        }
      },
      "required": [
        "kind"
      ]
    },
    "eventstore-capture-validation": {
      "properties": {
        "kind": {
          "const": "eventstore-capture-validation"
        }
      },
      "required": [
        "kind"
      ]
    },
    "failed-attempt-diagnostic": {
      "properties": {
        "kind": {
          "const": "failed-attempt-diagnostic"
        }
      },
      "required": [
        "kind"
      ]
    },
    "pathHash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectors",
        "total",
        "passed",
        "failed",
        "skipped"
      ],
      "properties": {
        "selectors": {
          "type": "integer",
          "minimum": 1
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dotnetSdk",
        "aspireSdk",
        "aspireCli",
        "communityToolkitAspireDapr",
        "daprCli",
        "daprRuntime",
        "daprDotnetPackages",
        "fluentUi",
        "nSubstitute",
        "fluxor"
      ],
      "properties": {
        "dotnetSdk": {
          "$ref": "#/$defs/version"
        },
        "aspireSdk": {
          "$ref": "#/$defs/version"
        },
        "aspireCli": {
          "$ref": "#/$defs/version"
        },
        "communityToolkitAspireDapr": {
          "$ref": "#/$defs/version"
        },
        "daprCli": {
          "$ref": "#/$defs/version"
        },
        "daprRuntime": {
          "$ref": "#/$defs/version"
        },
        "daprDotnetPackages": {
          "$ref": "#/$defs/version"
        },
        "fluentUi": {
          "$ref": "#/$defs/version"
        },
        "nSubstitute": {
          "$ref": "#/$defs/version"
        },
        "fluxor": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "containment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "g4Approved",
        "g5Approved",
        "deploymentApproved",
        "releaseApproved"
      ],
      "properties": {
        "g4Approved": {
          "const": false
        },
        "g5Approved": {
          "const": false
        },
        "deploymentApproved": {
          "const": false
        },
        "releaseApproved": {
          "const": false
        }
      }
    }
  }
}
