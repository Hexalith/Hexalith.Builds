{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.dev/schemas/hexalith.module-descriptor.v1.json",
  "title": "Hexalith executable module descriptor v1 result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "moduleId", "domainServiceProject"],
  "dependentRequired": {
    "uiAssembly": ["uiMarkerType"],
    "uiMarkerType": ["uiAssembly"]
  },
  "properties": {
    "schema": { "const": "hexalith.module-descriptor.v1" },
    "moduleId": { "type": "string", "maxLength": 63, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "domainServiceProject": { "$ref": "#/$defs/projectPath" },
    "apiProject": { "$ref": "#/$defs/projectPath" },
    "uiAssembly": { "$ref": "#/$defs/assemblyPath" },
    "uiMarkerType": { "$ref": "#/$defs/markerType" }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\/$).+$"
    },
    "projectPath": { "allOf": [{ "$ref": "#/$defs/repositoryPath" }, { "pattern": "\\.csproj$" }] },
    "assemblyPath": { "allOf": [{ "$ref": "#/$defs/repositoryPath" }, { "pattern": "\\.dll$" }] },
    "markerType": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:[.+][A-Za-z_][A-Za-z0-9_]*)+$"
    }
  }
}
