{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.com/schemas/hexalith.perimeter.v1.json",
  "title": "Hexalith owned perimeter v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "hexalith.perimeter.v1"
    },
    "entries": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "path"
            ],
            "properties": {
              "kind": {
                "const": "whole"
              },
              "path": {
                "$ref": "#/$defs/repositoryPath"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "path"
            ],
            "properties": {
              "kind": {
                "const": "whole-dir"
              },
              "path": {
                "$ref": "#/$defs/repositoryPath"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "path",
              "buildsTag"
            ],
            "properties": {
              "kind": {
                "const": "gitlink"
              },
              "path": {
                "$ref": "#/$defs/repositoryPath"
              },
              "buildsTag": {
                "type": "string",
                "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "path",
              "submodulePath",
              "url"
            ],
            "properties": {
              "kind": {
                "const": "gitmodules-section"
              },
              "path": {
                "$ref": "#/$defs/repositoryPath"
              },
              "submodulePath": {
                "$ref": "#/$defs/repositoryPath"
              },
              "url": {
                "allOf": [
                  {
                    "$ref": "#/$defs/string"
                  },
                  {
                    "minLength": 1,
                    "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f])[\\s\\S]+(?![\\s\\S])"
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "path",
              "pointer",
              "values"
            ],
            "properties": {
              "kind": {
                "const": "json-superset"
              },
              "path": {
                "$ref": "#/$defs/repositoryPath"
              },
              "pointer": {
                "allOf": [
                  {
                    "$ref": "#/$defs/string"
                  },
                  {
                    "pattern": "^(?:/(?:[^~]|~[01])*)?(?![\\s\\S])"
                  }
                ]
              },
              "values": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/string"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "path",
              "text"
            ],
            "properties": {
              "kind": {
                "const": "marker-block"
              },
              "path": {
                "$ref": "#/$defs/repositoryPath"
              },
              "text": {
                "allOf": [
                  {
                    "$ref": "#/$defs/string"
                  },
                  {
                    "not": {
                      "pattern": "<!-- hexalith-cicd:(?:begin|end) -->"
                    }
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "pattern"
            ],
            "properties": {
              "kind": {
                "const": "absent-glob"
              },
              "pattern": {
                "$ref": "#/$defs/repositoryPattern"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "path",
              "selectors"
            ],
            "properties": {
              "kind": {
                "const": "absent-json"
              },
              "path": {
                "$ref": "#/$defs/repositoryPath"
              },
              "selectors": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/string"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "path",
              "pattern"
            ],
            "properties": {
              "kind": {
                "const": "absent-line"
              },
              "path": {
                "$ref": "#/$defs/repositoryPath"
              },
              "pattern": {
                "allOf": [
                  {
                    "$ref": "#/$defs/string"
                  },
                  {
                    "format": "regex"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "string": {
      "type": "string",
      "pattern": "^(?![\\s\\S]*[\\ud800-\\udfff])[\\s\\S]*(?![\\s\\S])"
    },
    "repositoryPattern": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?![\\s\\S]*\\\\)(?![\\s\\S]*//)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|(?![\\s\\S])))(?![\\s\\S]*/(?![\\s\\S]))(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f])(?![\\s\\S]*\\$\\{\\{)(?![\\s\\S]*[\\ud800-\\udfff])[\\s\\S]+(?![\\s\\S])"
    },
    "repositoryPath": {
      "allOf": [
        {
          "$ref": "#/$defs/repositoryPattern"
        },
        {
          "not": {
            "pattern": "[*?\\[\\]]"
          }
        }
      ]
    }
  }
}
