              },
              "uniqueItems": true
            },
            "diagnosticIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identity"
              },
              "uniqueItems": true
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "disposition": {
                    "not": {
                      "const": "not-requested"
                    }
                  }
                }
              },
              "then": {
