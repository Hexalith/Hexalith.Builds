        },
        "attachedRunId": {
          "$ref": "#/$defs/identity"
        },
        "requestedHoldSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14400
        },
        "acceptedAt": {
          "$ref": "#/$defs/utc"
        },
        "effectiveHoldSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14400
        },
        "expiresAt": {
          "$ref": "#/$defs/utc"
        },
        "end": {
          "$ref": "#/$defs/holdEnd"
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "requestedHoldSeconds"
              ]
            }
          },
          "then": {
            "properties": {
              "effectiveHoldSeconds": {
                "const": 1800
              }
            }
          }
        }
      ]
