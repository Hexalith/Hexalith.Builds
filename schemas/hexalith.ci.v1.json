{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.com/schemas/hexalith.ci.v1.json",
  "title": "Hexalith CI configuration v1",
  "description": "Complete materialized configuration. Defaults describe renderer output; readers never insert them. Repository identity and enabled exclusion targets are checked by the loader.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "solution",
    "dapr",
    "browsers",
    "registry",
    "codeql",
    "tests",
    "hooks",
    "jobs",
    "submodules",
    "ciTimeoutMinutes",
    "npmWorkspaces",
    "dotnetTools"
  ],
  "properties": {
    "schema": {
      "const": "hexalith.ci.v1"
    },
    "buildsTag": {
      "type": "string",
      "description": "Exact stable release tag. Required by the loader outside Builds itself, including samples.",
      "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "solution": {
      "anyOf": [
        {
          "const": "none"
        },
        {
          "$ref": "#/$defs/solutionPath"
        }
      ],
      "default": "none"
    },
    "dapr": {
      "type": "boolean",
      "default": false
    },
    "browsers": {
      "type": "boolean",
      "default": false
    },
    "registry": {
      "type": "boolean",
      "default": false
    },
    "aspire": {
      "type": "boolean",
      "description": "Enable the trusted Linux amd64 native Aspire toolchain. Omission preserves the existing disabled behavior. Requires dapr=true."
    },
    "job-timeout-minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 360,
      "description": "Optional bound for the complete CI job. Omission preserves the shared 30-minute default."
    },
    "codeql": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "c-cpp",
          "csharp",
          "go",
          "java-kotlin",
          "javascript-typescript",
          "python",
          "ruby",
          "rust",
          "swift"
        ]
      },
      "description": "Renderer default is csharp with a solution, or empty with solution=none. An explicit empty list skips analysis; actions is forbidden."
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integration",
        "exclude",
        "minimumExpectedTests",
        "failSkips"
      ],
      "properties": {
        "integration": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/projectPath"
          },
          "default": []
        },
        "exclude": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/projectPath"
          },
          "additionalProperties": {
            "$ref": "#/$defs/actionName"
          },
          "default": {},
          "description": "Project to enabled hook or job. The loader checks dynamic membership; an exclusion is never a plain skip."
        },
        "minimumExpectedTests": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/projectPath"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          },
          "default": {},
          "description": "Minimum tests per discovered, nonexcluded project. Requires Microsoft.Testing.Platform with xUnit."
        },
        "failSkips": {
          "type": "boolean",
          "default": false
        }
      },
      "default": {
        "integration": [],
        "exclude": {},
        "minimumExpectedTests": {},
        "failSkips": false
      }
    },
    "hooks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "after-unit-tests",
          "after-integration-tests",
          "nightly"
        ]
      },
      "default": []
    },
    "jobs": {
      "type": "object",
      "propertyNames": {
        "allOf": [
          {
            "$ref": "#/$defs/actionName"
          },
          {
            "not": {
              "enum": [
                "ci",
                "after-unit-tests",
                "after-integration-tests",
                "nightly"
              ]
            }
          }
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "runner"
        ],
        "properties": {
          "runner": {
            "anyOf": [
              {
                "enum": [
                  "windows-latest",
                  "macos-latest"
                ]
              },
              {
                "$ref": "#/$defs/privateQualificationRunner"
              }
            ]
          }
        },
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runner"
            ],
            "properties": {
              "runner": {
                "enum": [
                  "windows-latest",
                  "macos-latest"
                ]
              }
            }
          },
          {
            "$ref": "#/$defs/manualQualificationJob"
          }
        ]
      },
      "default": {},
      "properties": {
        "none": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runner"
          ],
          "properties": {
            "runner": {
              "enum": [
                "windows-latest",
                "macos-latest"
              ]
            }
          }
        }
      }
    },
    "submodules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryPath"
      },
      "default": [],
      "description": "Additional direct submodule paths relative to the repository. Builds checkout is implicit. No nested or recursive initialization."
    },
    "ciTimeoutMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 360,
      "default": 30,
      "description": "Maximum shared CI build/test job duration, forwarded to job-timeout-minutes."
    },
    "npmWorkspaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryPath"
      },
      "default": [],
      "description": "Repository-relative npm workspace directories with committed package.json and package-lock.json. Prepared once without lifecycle scripts."
    },
    "dotnetTools": {
      "type": "boolean",
      "default": false,
      "description": "Restore the module-owned exact-version .config/dotnet-tools.json through the trusted Builds NuGet configuration."
    },
    "moduleManifest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/jsonPath"
        }
      ],
      "default": null,
      "description": "Opt in to producer-owned package-mode build preparation before project evaluation."
    },
    "windowsCheckout": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/windowsCheckout"
        }
      ],
      "default": null,
      "description": "Centrally reviewed immutable archive trees excluded only from protected Windows checkout."
    },
    "additionalSdkVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "description": "Optional exact SDK for older targeting packs and isolated package-consumer fixtures. Forwarded to shared CI preparation, never installed by a module action."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "aspire": {
            "const": true
          }
        },
        "required": [
          "aspire"
        ]
      },
      "then": {
        "properties": {
          "dapr": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "solution": {
            "const": "none"
          }
        },
        "required": [
          "solution"
        ]
      },
      "then": {
        "properties": {
          "dapr": {
            "const": false
          },
          "browsers": {
            "const": false
          },
          "aspire": {
            "const": false
          },
          "tests": {
            "const": {
              "integration": [],
              "exclude": {},
              "minimumExpectedTests": {},
              "failSkips": false
            }
          },
          "hooks": {
            "const": []
          },
          "jobs": {
            "const": {}
          },
          "codeql": {
            "default": []
          },
          "npmWorkspaces": {
            "const": []
          },
          "dotnetTools": {
            "const": false
          },
          "moduleManifest": {
            "const": null
          },
          "windowsCheckout": {
            "const": null
          }
        }
      },
      "else": {
        "properties": {
          "codeql": {
            "default": [
              "csharp"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?![\\s\\S]*\\\\)(?![\\s\\S]*//)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|(?![\\s\\S])))(?![\\s\\S]*/(?![\\s\\S]))(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f])(?![\\s\\S]*\\$\\{\\{)[\\s\\S]+(?![\\s\\S])"
    },
    "solutionPath": {
      "allOf": [
        {
          "$ref": "#/$defs/repositoryPath"
        },
        {
          "pattern": "\\.slnx(?![\\s\\S])"
        }
      ]
    },
    "projectPath": {
      "allOf": [
        {
          "$ref": "#/$defs/repositoryPath"
        },
        {
          "pattern": "\\.csproj(?![\\s\\S])"
        }
      ]
    },
    "actionName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "jsonPath": {
      "allOf": [
        {
          "$ref": "#/$defs/repositoryPath"
        },
        {
          "pattern": "\\.json(?![\\s\\S])"
        }
      ]
    },
    "windowsCheckout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exclude"
      ],
      "properties": {
        "exclude": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "tree"
            ],
            "properties": {
              "path": {
                "allOf": [
                  {
                    "$ref": "#/$defs/repositoryPath"
                  },
                  {
                    "pattern": "^(?![\\s\\S]*[\\\\:<>\"|?*])(?![\\s\\S]*[. ](?:/|(?![\\s\\S])))[\\s\\S]+(?![\\s\\S])"
                  }
                ]
              },
              "tree": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
              }
            }
          },
          "description": "The loader additionally rejects case aliases, overlaps, reserved Windows names and protected product paths."
        }
      }
    },
    "privateQualificationRunner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "labels"
      ],
      "properties": {
        "group": {
          "$ref": "#/$defs/resourceName"
        },
        "labels": {
          "const": [
            "self-hosted",
            "linux",
            "x64"
          ]
        }
      }
    },
    "manualQualificationJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "trigger",
        "environment",
        "secrets",
        "preparation",
        "timeoutMinutes"
      ],
      "properties": {
        "trigger": {
          "const": "manual"
        },
        "runner": {
          "$ref": "#/$defs/privateQualificationRunner"
        },
        "environment": {
          "$ref": "#/$defs/resourceName"
        },
        "secrets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!(?:GITHUB_|ACTIONS_|RUNNER_))[A-Z_][A-Z0-9_]*(?![\\s\\S])"
          }
        },
        "preparation": {
          "const": "build-only"
        },
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        }
      },
      "description": "Manual qualification after green CI at the same SHA, with a private runner, approval environment, explicit secrets and preserved fixture runtimes."
    },
    "resourceName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
    }
  }
}
