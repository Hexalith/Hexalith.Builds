{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.com/schemas/hexalith.ci.v1.json",
  "title": "Hexalith CI configuration v1",
  "description": "Complete materialized configuration. Defaults describe renderer output; readers never insert them. Repository identity and enabled exclusion targets are checked by the loader.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "solution",
    "dapr",
    "browsers",
    "registry",
    "codeql",
    "tests",
    "hooks",
    "jobs",
    "submodules",
    "ciTimeoutMinutes",
    "npmWorkspaces",
    "dotnetTools"
  ],
  "properties": {
    "schema": {
      "const": "hexalith.ci.v1"
    },
    "docs": {
      "description": "Apply README checks in warning or failing mode. The renderer enables warnings on adoption of this contract. Previously delivered documents may omit this field.",
      "type": "string",
      "enum": ["off", "warn", "fail"],
      "default": "warn"
    },
    "buildsTag": {
      "type": "string",
      "description": "Exact stable release tag. Required by the loader outside Builds itself, including samples.",
      "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "solution": {
      "anyOf": [
        {
          "const": "none"
        },
        {
          "$ref": "#/$defs/solutionPath"
        }
      ],
      "default": "none"
    },
    "dapr": {
      "type": "boolean",
      "default": false
    },
    "browsers": {
      "type": "boolean",
      "default": false
    },
    "registry": {
      "type": "boolean",
      "default": false
    },
    "aspire": {
      "type": "boolean",
      "description": "Enable the trusted Linux amd64 native Aspire toolchain. Omission preserves the existing disabled behavior. Requires dapr=true."
    },
    "job-timeout-minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 360,
      "description": "Optional bound for the complete CI job. Omission preserves the shared 30-minute default."
    },
    "codeql": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "c-cpp",
          "csharp",
          "go",
          "java-kotlin",
          "javascript-typescript",
          "python",
          "ruby",
          "rust",
          "swift"
        ]
      },
      "description": "Renderer default is csharp with a solution, or empty with solution=none. An explicit empty list skips analysis; actions is forbidden."
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integration",
        "exclude",
        "minimumExpectedTests",
        "failSkips"
      ],
      "properties": {
        "integration": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/projectPath"
          },
          "default": []
        },
        "exclude": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/projectPath"
          },
          "additionalProperties": {
            "$ref": "#/$defs/actionName"
          },
          "default": {},
          "description": "Project to enabled hook or job. The loader checks dynamic membership; an exclusion is never a plain skip."
        },
        "minimumExpectedTests": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/projectPath"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          },
          "default": {},
          "description": "Minimum tests per discovered, nonexcluded project. Requires Microsoft.Testing.Platform with xUnit."
        },
        "failSkips": {
          "type": "boolean",
          "default": false
        },
        "additional": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/projectPath"
          }
        },
        "reports": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trx": {
              "type": "boolean"
            },
            "coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "projects"
              ],
              "properties": {
                "projects": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/projectPath"
                  }
                },
                "lineScope": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/sourcePrefix"
                  }
                },
                "minimumLine": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "lineComparison": {
                  "enum": [
                    "greater-than",
                    "at-least"
                  ]
                },
                "branchTargets": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/repositoryPath"
                  }
                },
                "minimumBranch": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "allOf": [
                {
                  "if": {
                    "required": [
                      "minimumLine"
                    ]
                  },
                  "then": {
                    "required": [
                      "lineScope"
                    ],
                    "properties": {
                      "lineScope": {
                        "minItems": 1
                      }
                    }
                  }
                },
                {
                  "if": {
                    "required": [
                      "minimumBranch"
                    ]
                  },
                  "then": {
                    "required": [
                      "branchTargets"
                    ],
                    "properties": {
                      "branchTargets": {
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "default": {
        "integration": [],
        "exclude": {},
        "minimumExpectedTests": {},
        "failSkips": false
      }
    },
    "hooks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "after-unit-tests",
          "after-integration-tests",
          "nightly"
        ]
      },
      "default": []
    },
    "jobs": {
      "type": "object",
      "propertyNames": {
        "allOf": [
          {
            "$ref": "#/$defs/actionName"
          },
          {
            "not": {
              "enum": [
                "ci",
                "after-unit-tests",
                "after-integration-tests",
                "nightly"
              ]
            }
          }
        ]
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runner"
            ],
            "properties": {
              "runner": {
                "oneOf": [
                  {
                    "enum": [
                      "ubuntu-latest",
                      "ubuntu-24.04",
                      "windows-latest",
                      "macos-latest"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "group",
                      "labels"
                    ],
                    "properties": {
                      "group": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}(?![\\s\\S])"
                      },
                      "labels": {
                        "const": [
                          "self-hosted",
                          "linux",
                          "x64"
                        ]
                      }
                    }
                  }
                ]
              },
              "timeoutMinutes": {
                "$ref": "#/$defs/minutes"
              },
              "trigger": {
                "enum": [
                  "ci",
                  "nightly",
                  "manual"
                ]
              },
              "matrix": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "include"
                ],
                "properties": {
                  "include": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "required": [
                        "id"
                      ],
                      "propertyNames": {
                        "$ref": "#/$defs/actionName"
                      },
                      "properties": {
                        "id": {
                          "$ref": "#/$defs/actionName"
                        }
                      },
                      "additionalProperties": {
                        "$ref": "#/$defs/safeText"
                      }
                    }
                  }
                }
              },
              "maxParallel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "needs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/actionName"
                }
              },
              "runAfterFailure": {
                "type": "boolean"
              },
              "resourceProfile": {
                "const": "mutation"
              },
              "environment": {
                "$ref": "#/$defs/actionName"
              },
              "secrets": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^(?!(?:GITHUB_|ACTIONS_|RUNNER_|CI_|PYTHON|NODE_|DOTNET_))(?!(?:PATH|HOME|TMPDIR|TMP|TEMP|BASH_ENV|ENV|LD_PRELOAD|LD_LIBRARY_PATH|SHELLOPTS|BASHOPTS|HEXALITH_JOB_NAME|HEXALITH_JOB_PARAMETERS|HEXALITH_JOB_NEEDS|HEXALITH_QUALIFICATION_PARAMETERS|HEXALITH_AUTHORITY_SHA256|HEXALITH_SOURCE_SHA)(?![\\s\\S]))[A-Z][A-Z0-9_]*(?![\\s\\S])"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*(?![\\s\\S])"
                }
              },
              "setup": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "dapr": {
                    "type": "boolean"
                  },
                  "browsers": {
                    "type": "boolean"
                  },
                  "registry": {
                    "type": "boolean"
                  },
                  "aspire": {
                    "type": "boolean",
                    "description": "Enable the trusted Linux amd64 native Aspire toolchain. Omission preserves the existing disabled behavior. Requires dapr=true."
                  },
                  "npmWorkspaces": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "$ref": "#/$defs/repositoryPath"
                    },
                    "description": "Repository-relative npm workspace directories with committed package.json and package-lock.json. Prepared once without lifecycle scripts."
                  },
                  "dotnetTools": {
                    "type": "boolean",
                    "description": "Restore the module-owned exact-version .config/dotnet-tools.json through the trusted Builds NuGet configuration."
                  },
                  "prerequisites": {
                    "$ref": "#/$defs/prerequisites"
                  }
                }
              },
              "preparation": {
                "const": "build-only"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "runner": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "runner"
                  ]
                },
                "then": {
                  "required": [
                    "environment",
                    "trigger"
                  ],
                  "properties": {
                    "trigger": {
                      "const": "manual"
                    },
                    "timeoutMinutes": {
                      "maximum": 180
                    }
                  },
                  "not": {
                    "required": [
                      "setup"
                    ]
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "secrets"
                  ]
                },
                "then": {
                  "required": [
                    "environment",
                    "trigger"
                  ],
                  "properties": {
                    "trigger": {
                      "const": "manual"
                    },
                    "runner": {
                      "type": "object"
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "preparation"
                  ]
                },
                "then": {
                  "required": [
                    "runner",
                    "trigger",
                    "secrets"
                  ],
                  "properties": {
                    "runner": {
                      "type": "object"
                    },
                    "trigger": {
                      "const": "manual"
                    },
                    "secrets": {
                      "type": "object"
                    }
                  }
                }
              }
            ]
          },
          {
            "$ref": "#/$defs/manualQualificationJob"
          }
        ],
        "type": "object",
        "required": [
          "runner"
        ],
        "properties": {
          "runner": {
            "type": [
              "string",
              "object"
            ]
          }
        }
      },
      "default": {},
      "maxProperties": 64,
      "allOf": [
        {
          "properties": {
            "none": {
              "not": {
                "required": [
                  "trigger"
                ],
                "properties": {
                  "trigger": {
                    "const": "manual"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "submodules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryPath"
      },
      "default": [],
      "description": "Additional direct submodule paths relative to the repository. Builds checkout is implicit. No nested or recursive initialization."
    },
    "ciTimeoutMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 360,
      "default": 30,
      "description": "Maximum shared CI build/test job duration, forwarded to job-timeout-minutes."
    },
    "npmWorkspaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryPath"
      },
      "default": [],
      "description": "Repository-relative npm workspace directories with committed package.json and package-lock.json. Prepared once without lifecycle scripts."
    },
    "dotnetTools": {
      "type": "boolean",
      "default": false,
      "description": "Restore the module-owned exact-version .config/dotnet-tools.json through the trusted Builds NuGet configuration."
    },
    "prerequisites": {
      "$ref": "#/$defs/prerequisites"
    },
    "releaseTimeoutMinutes": {
      "$ref": "#/$defs/minutes"
    },
    "nightlyTimeoutMinutes": {
      "$ref": "#/$defs/minutes"
    },
    "moduleManifest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/jsonPath"
        }
      ],
      "default": null,
      "description": "Opt in to producer-owned package-mode build preparation before project evaluation."
    },
    "windowsCheckout": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/windowsCheckout"
        }
      ],
      "default": null,
      "description": "Centrally reviewed immutable archive trees excluded only from protected Windows checkout."
    },
    "additionalSdkVersion": {
      "type": "string",
      "pattern": "^11\\.0\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "description": "Optional exact .NET 11 SDK for package-consumer fixtures. Forwarded to shared CI preparation, never installed by a module action."
    },
    "publishedBuilds": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/jsonPath"
        }
      ],
      "default": null,
      "description": "Committed historical signed Builds shared-release handoff; mutually exclusive with moduleManifest."
    },
    "buildProjects": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "project"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/actionName"
          },
          "project": {
            "$ref": "#/$defs/projectPath"
          },
          "versions": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "HexalithEventStoreVersion": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])"
              },
              "HexalithTenantsVersion": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])"
              },
              "HexalithMemoriesVersion": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])"
              }
            }
          },
          "isolatedContract": {
            "$ref": "#/$defs/jsonPath"
          }
        },
        "oneOf": [
          {
            "required": [
              "versions"
            ]
          },
          {
            "required": [
              "isolatedContract"
            ]
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "aspire": {
            "const": true
          }
        },
        "required": [
          "aspire"
        ]
      },
      "then": {
        "properties": {
          "dapr": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "solution": {
            "const": "none"
          }
        },
        "required": [
          "solution"
        ]
      },
      "then": {
        "properties": {
          "dapr": {
            "const": false
          },
          "browsers": {
            "const": false
          },
          "aspire": {
            "const": false
          },
          "tests": {
            "const": {
              "integration": [],
              "exclude": {},
              "minimumExpectedTests": {},
              "failSkips": false
            }
          },
          "hooks": {
            "const": []
          },
          "jobs": {
            "const": {}
          },
          "codeql": {
            "default": []
          },
          "npmWorkspaces": {
            "const": []
          },
          "dotnetTools": {
            "const": false
          },
          "prerequisites": {
            "const": {}
          },
          "moduleManifest": {
            "const": null
          },
          "windowsCheckout": {
            "const": null
          },
          "publishedBuilds": {
            "const": null
          },
          "buildProjects": {
            "const": []
          }
        }
      },
      "else": {
        "properties": {
          "codeql": {
            "default": [
              "csharp"
            ]
          }
        }
      }
    },
    {
      "not": {
        "required": [
          "moduleManifest",
          "publishedBuilds"
        ],
        "properties": {
          "moduleManifest": {
            "type": "string"
          },
          "publishedBuilds": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "buildProjects"
        ],
        "properties": {
          "buildProjects": {
            "minItems": 1,
            "contains": {
              "required": [
                "versions"
              ]
            }
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "moduleManifest"
            ],
            "properties": {
              "moduleManifest": {
                "type": "string"
              }
            }
          },
          {
            "required": [
              "publishedBuilds"
            ],
            "properties": {
              "publishedBuilds": {
                "type": "string"
              }
            }
          }
        ],
        "properties": {
          "jobs": {
            "additionalProperties": {
              "properties": {
                "runner": {
                  "not": {
                    "enum": [
                      "windows-latest",
                      "macos-latest"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "publishedBuilds"
        ],
        "properties": {
          "publishedBuilds": {
            "type": "string"
          }
        }
      },
      "then": {
        "properties": {
          "jobs": {
            "additionalProperties": {
              "properties": {
                "runner": {
                  "not": {
                    "enum": [
                      "windows-latest",
                      "macos-latest"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "buildProjects"
        ],
        "properties": {
          "buildProjects": {
            "contains": {
              "required": [
                "isolatedContract"
              ]
            }
          }
        }
      },
      "then": {
        "required": [
          "moduleManifest"
        ],
        "properties": {
          "moduleManifest": {
            "type": "string"
          }
        }
      }
    }
  ],
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?![\\s\\S]*\\\\)(?![\\s\\S]*//)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|(?![\\s\\S])))(?![\\s\\S]*/(?![\\s\\S]))(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f])(?![\\s\\S]*\\$\\{\\{)[\\s\\S]+(?![\\s\\S])"
    },
    "solutionPath": {
      "allOf": [
        {
          "$ref": "#/$defs/repositoryPath"
        },
        {
          "pattern": "\\.slnx(?![\\s\\S])"
        }
      ]
    },
    "projectPath": {
      "allOf": [
        {
          "$ref": "#/$defs/repositoryPath"
        },
        {
          "pattern": "\\.csproj(?![\\s\\S])"
        }
      ]
    },
    "actionName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 360
    },
    "safeText": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f])(?![\\s\\S]*\\$\\{\\{)[\\s\\S]*(?![\\s\\S])"
    },
    "prerequisites": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeVersion": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "npmVersion": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "apt": {
          "type": "boolean"
        },
        "tlsTrust": {
          "type": "boolean"
        },
        "daprProfile": {
          "const": "catalog"
        }
      },
      "dependentRequired": {
        "nodeVersion": [
          "npmVersion"
        ],
        "npmVersion": [
          "nodeVersion"
        ]
      }
    },
    "sourcePrefix": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?![\\s\\S]*\\\\)(?![\\s\\S]*//)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|(?![\\s\\S])))(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f])(?![\\s\\S]*\\$\\{\\{)[\\s\\S]+(?![\\s\\S])"
    },
    "jsonPath": {
      "allOf": [
        {
          "$ref": "#/$defs/repositoryPath"
        },
        {
          "pattern": "\\.json(?![\\s\\S])"
        }
      ]
    },
    "windowsCheckout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exclude"
      ],
      "properties": {
        "exclude": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "tree"
            ],
            "properties": {
              "path": {
                "allOf": [
                  {
                    "$ref": "#/$defs/repositoryPath"
                  },
                  {
                    "pattern": "^(?![\\s\\S]*[\\\\:<>\"|?*])(?![\\s\\S]*[. ](?:/|(?![\\s\\S])))[\\s\\S]+(?![\\s\\S])"
                  }
                ]
              },
              "tree": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
              }
            }
          },
          "description": "The loader additionally rejects case aliases, overlaps, reserved Windows names and protected product paths."
        }
      }
    },
    "privateQualificationRunner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "labels"
      ],
      "properties": {
        "group": {
          "$ref": "#/$defs/resourceName"
        },
        "labels": {
          "const": [
            "self-hosted",
            "linux",
            "x64"
          ]
        }
      }
    },
    "manualQualificationJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "trigger",
        "environment",
        "secrets",
        "preparation",
        "timeoutMinutes"
      ],
      "properties": {
        "trigger": {
          "const": "manual"
        },
        "runner": {
          "$ref": "#/$defs/privateQualificationRunner"
        },
        "environment": {
          "$ref": "#/$defs/resourceName"
        },
        "secrets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!(?:HEXALITH_JOB_NAME|HEXALITH_JOB_PARAMETERS|HEXALITH_JOB_NEEDS|HEXALITH_QUALIFICATION_PARAMETERS|HEXALITH_AUTHORITY_SHA256|HEXALITH_SOURCE_SHA)(?![\\s\\S]))(?!(?:GITHUB_|ACTIONS_|RUNNER_))[A-Z_][A-Z0-9_]*(?![\\s\\S])"
          }
        },
        "preparation": {
          "const": "build-only"
        },
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        }
      },
      "description": "Manual qualification after green CI at the same SHA, with a private runner, approval environment, explicit secrets and preserved fixture runtimes."
    },
    "resourceName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
    }
  },
  "x-resource-profiles": {
    "mutation": {
      "container": {
        "image": "mcr.microsoft.com/dotnet/sdk@sha256:7913685c883a29dd8ba79da96172f5c6b29ed9be706ebe95935e3ef45f19c9c1",
        "options": "--cpus=4 --memory=10g --memory-swap=10g"
      },
      "env": {
        "DOTNET_PROCESSOR_COUNT": "2",
        "MSBUILDDISABLENODEREUSE": "1",
        "DOTNET_CLI_USE_MSBUILD_SERVER": "0",
        "UseSharedCompilation": "false"
      }
    }
  }
}
