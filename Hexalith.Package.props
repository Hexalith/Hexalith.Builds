<Project>
  <PropertyGroup>
    <Authors>Jérôme Piquot</Authors>
    <Company>ITANEO</Company>
    <Product>Hexalith</Product>
    <PackageTags>
      Hexalith;.NET;DDD;CLEAN;Distributed;Event Driven;Microservice;Event
      Sourcing;Blazor;Fluent UI;ASP Net Core;
    </PackageTags>
    <Description>
      Hexalith is a set of libraries to build an application with micro-service
      architecture.
    </Description>
    <RepositoryUrl>https://github.com/Hexalith/Hexalith</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable Condition="'$(IDEBuild)' != 'true'">true</IsPackable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <VersionSuffix Condition="'$(GITHUB_RUN_NUMBER)' != ''">preview-$(GITHUB_RUN_NUMBER)</VersionSuffix>
    <!-- $(Date:...) is Azure Pipelines syntax and expands to nothing in MSBuild,
         so local non-Release builds silently produced no version suffix. -->
    <VersionSuffix Condition="'$(GITHUB_RUN_NUMBER)' == ''">$([System.DateTime]::UtcNow.ToString('yyyyMMddHHmmss'))</VersionSuffix>
  </PropertyGroup>
  <ItemGroup>
    <!-- Replace explicitly packed root README items inherited from an enclosing module.
         Item transforms work during evaluation; metadata Conditions here do not.
         Preserve unpacked README items and README files packaged below the root. -->
    <_HexalithPackedRootReadme Include="@(None->HasMetadata('PackagePath')->WithMetadataValue('Pack', 'true')->WithMetadataValue('Filename', 'README')->WithMetadataValue('Extension', '.md'))" />
    <None Remove="@(_HexalithPackedRootReadme->WithMetadataValue('PackagePath', '/'));@(_HexalithPackedRootReadme->WithMetadataValue('PackagePath', '\'))" MatchOnMetadata="FullPath;Pack;PackagePath" />
    <_HexalithPackedRootReadme Remove="@(_HexalithPackedRootReadme)" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="">
      <Link>icon.png</Link>
    </None>
    <None Include="$(ProjectRoot)/README.md" Pack="true" PackagePath="\">
      <Link>README.md</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="Hexalith.globalconfig" />
  </ItemGroup>
</Project>