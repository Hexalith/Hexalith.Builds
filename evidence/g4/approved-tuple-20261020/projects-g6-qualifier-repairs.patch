+def source_build_arguments() -> list[str]:
+    """Bind the source lane to direct workspace dependencies without nested checkouts."""
+    names = ("Builds", "Commons", "Conversations", "EventStore", "Folders", "FrontComposer",
+             "McpCli", "Memories", "Parties", "Platform", "Tenants")
+    return ["--configuration", "Debug", "--no-incremental", "-m:1",
+            "-p:UseHexalithProjectReferences=true", "-v:minimal",
+            *[f"-p:Hexalith{name}Root={ROOT / 'references' / ('Hexalith.' + name)}" for name in names],
+            f"-p:HexalithAiToolsRoot={ROOT / 'references/Hexalith.AI.Tools'}"]
+
+
+def platform_build_command(platform: Path, scratch: Path) -> list[str]:
+    """Keep the file host package lane and each referenced project's artifacts separate."""
+    return ["dotnet", "build", str(platform), "--configuration", "Debug",
+            "--no-incremental", "-v:minimal", "--artifacts-path", str(scratch / "platform-artifacts"),
+            "-p:UseHexalithProjectReferences=false"]
+
+
