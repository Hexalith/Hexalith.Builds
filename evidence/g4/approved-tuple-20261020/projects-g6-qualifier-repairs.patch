+    def test_source_lane_names_direct_workspace_dependency_roots(self) -> None:
+        command = RUNNER.source_build_arguments()
+        self.assertIn("-p:UseHexalithProjectReferences=true", command)
+        for name in ("EventStore", "Commons", "Tenants", "Memories", "FrontComposer"):
+            self.assertIn(f"-p:Hexalith{name}Root={ROOT / 'references' / ('Hexalith.' + name)}", command)
+        self.assertFalse(any("/references/Hexalith.Folders/references/" in arg for arg in command))
+
+    def test_platform_file_host_uses_packages_and_per_project_artifacts(self) -> None:
+        platform = ROOT / "references/Hexalith.Platform/apphost.cs"
+        scratch = ROOT / ".g6-current-evidence/scratch"
+        command = RUNNER.platform_build_command(platform, scratch)
+        self.assertEqual(["dotnet", "build", str(platform)], command[:3])
+        self.assertIn("-p:UseHexalithProjectReferences=false", command)
+        self.assertEqual(str(scratch / "platform-artifacts"), command[command.index("--artifacts-path") + 1])
+        self.assertFalse(any("BaseIntermediateOutputPath" in arg for arg in command))
+
