+    def testRetentionFixturePreservesCompletedProofAndOtherTenant(self):
+        proof = {"codecVersion": 1, "tenantId": "tenant-a", "domain": "counter",
+                 "aggregateId": "fixture", "headSequence": 12, "retainedFloor": 1,
+                 "sourceIncarnation": "actor-created-incarnation", "headMessageId": "actor-created-head",
+                 "cumulativeDigest": "a" * 64, "erased": False}
+        for source_proof in (proof, None):
+            with self.subTest(proof=source_proof is not None):
+                metadata = {"currentSequence": 12, "retainedFloor": 1, "sourceProof": source_proof}
+                key = "tenant-a:counter:fixture:metadata"
+                values = {key: executor.canonical(metadata),
+                          "tenant-b:counter:fixture:metadata": executor.canonical(metadata),
+                          "tenant-a:counter:fixture:snapshot": executor.canonical({"sequenceNumber": 9})}
+                values.update({"tenant-a:counter:fixture:events:" + str(i): b"{}" for i in range(1, 13)})
+                worker = executor.Executor.__new__(executor.Executor)
+                worker.active, worker.redis = [], "owned"
+                worker.raw_state = mock.Mock(return_value=values)
+                worker.postgres_write, worker.postgres_delete = mock.Mock(), mock.Mock()
+                worker.mutate("retained")
+                expected = copy.deepcopy(metadata)
+                expected["retainedFloor"] = 5
+                if source_proof is not None:
+                    expected["sourceProof"]["retainedFloor"] = 5
+                worker.postgres_write.assert_called_once_with("owned", key, expected)
+                self.assertEqual(worker.postgres_delete.call_args_list,
+                                 [mock.call("owned", "tenant-a:counter:fixture:events:" + str(i)) for i in range(1, 5)])
+                self.assertEqual(metadata["sourceProof"], source_proof)
+
+    def testRetentionFixtureRefusesContradictoryProofAndKeepsInvalidFloorControl(self):
+        for defect in ("retainedFloor", "headSequence", "shape", None):
+            with self.subTest(defect=defect):
+                proof = {"retainedFloor": 1, "headSequence": 12, "cumulativeDigest": "a" * 64}
+                if defect in proof:
+                    proof[defect] = 99
+                if defect == "shape":
+                    proof = "malformed"
+                metadata = {"currentSequence": 12, "retainedFloor": 1, "sourceProof": proof}
+                worker = executor.Executor.__new__(executor.Executor)
+                worker.active, worker.redis = [], "owned"
+                key = "tenant-a:counter:fixture:metadata"
+                worker.raw_state = mock.Mock(return_value={key: executor.canonical(metadata)})
+                worker.postgres_write, worker.postgres_delete = mock.Mock(), mock.Mock()
+                if defect is not None:
+                    with self.assertRaisesRegex(preparation.InvalidPacket, "source proof does not match metadata"):
+                        worker.mutate("retained")
+                    worker.postgres_write.assert_not_called()
+                worker.mutate("invalid-floor")
+                expected = copy.deepcopy(metadata)
+                expected["retainedFloor"] = 0
+                worker.postgres_write.assert_called_once_with("owned", key, expected)
+
     def testPostgresqlInventoryNormalizesDatabaseCollationOrder(self):
