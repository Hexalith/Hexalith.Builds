{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.com/schemas/hexalith.check-invocation.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "invocationId",
    "checkId",
    "attemptId",
    "environment",
    "executionMode",
    "servedReleaseDigest",
    "suiteDigest",
    "descriptorDigest",
    "profileDigest",
    "configurationDigest",
    "workingBaseline",
    "verificationEndpoint",
    "syntheticTenant",
    "syntheticTenantMode",
    "fixturePartyId",
    "fixtureCaseId",
    "externalEffectsDisabled",
    "startedAt",
    "deadlineAt"
  ],
  "properties": {
    "schema": {
      "const": "hexalith.check-invocation.v1"
    },
    "invocationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,127}(?![\\s\\S])"
    },
    "checkId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,127}(?![\\s\\S])"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,127}(?![\\s\\S])"
    },
    "environment": {
      "enum": [
        "staging",
        "production"
      ]
    },
    "executionMode": {
      "enum": [
        "hosted",
        "controlled"
      ]
    },
    "servedReleaseDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "suiteDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "descriptorDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "profileDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "configurationDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "workingBaseline": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attemptId",
            "releaseDigest",
            "profileDigest",
            "configurationDigest"
          ],
          "properties": {
            "attemptId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,127}(?![\\s\\S])"
            },
            "releaseDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
            },
            "profileDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
            },
            "configurationDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "verificationEndpoint": {
      "type": "string",
      "maxLength": 2048
    },
    "syntheticTenant": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,127}(?![\\s\\S])"
    },
    "syntheticTenantMode": {
      "enum": [
        "existing-synthetic",
        "run-scoped-synthetic"
      ]
    },
    "fixturePartyId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,127}(?![\\s\\S])"
    },
    "fixtureCaseId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,127}(?![\\s\\S])"
    },
    "externalEffectsDisabled": {
      "const": true
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?(?:Z|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "deadlineAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?(?:Z|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    }
  }
}
