{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.com/schemas/hexalith.check-result.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "invocationId",
    "checkId",
    "attemptId",
    "environment",
    "executionMode",
    "servedReleaseDigest",
    "suiteDigest",
    "descriptorDigest",
    "profileDigest",
    "configurationDigest",
    "workingBaseline",
    "outcome",
    "complete",
    "startedAt",
    "completedAt",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "hexalith.check-result.v1"
    },
    "invocationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,127}(?![\\s\\S])"
    },
    "checkId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,127}(?![\\s\\S])"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,127}(?![\\s\\S])"
    },
    "environment": {
      "enum": [
        "staging",
        "production"
      ]
    },
    "executionMode": {
      "enum": [
        "hosted",
        "controlled"
      ]
    },
    "servedReleaseDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "suiteDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "descriptorDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "profileDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "configurationDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "workingBaseline": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attemptId",
            "releaseDigest",
            "profileDigest",
            "configurationDigest"
          ],
          "properties": {
            "attemptId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,127}(?![\\s\\S])"
            },
            "releaseDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
            },
            "profileDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
            },
            "configurationDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "skipped",
        "timed-out",
        "incomplete"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?(?:Z|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?(?:Z|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "diagnostics": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "enum": [
          "assertion-failed",
          "deadline-expired",
          "runner-failure",
          "unsupported-check",
          "invalid-invocation",
          "unsafe-context",
          "skipped"
        ]
      },
      "uniqueItems": true
    }
  }
}
