+        int pointerSize = target32 ? 4 : 8;
+        nint parameters = Pointer(ReadMemory(process, peb + (target32 ? 0x10 : 0x20), pointerSize), 0, target32);
+        if (parameters == 0)
+        {
+            return [];
+        }
