<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="Hexalith.Builds.Tooling" HintPath="$(ToolPayload)/Hexalith.Builds.Tooling.dll" />
    <Reference Include="Aspire.Hosting" HintPath="$(ToolPayload)/g4-host/Aspire.Hosting.dll" />
    <!-- .NET 11 supplies Microsoft.Extensions through the declared framework.
         The loader gate verifies the child's resolved shared-runtime identities. -->
  </ItemGroup>
</Project>
