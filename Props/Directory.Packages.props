    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(HexalithAspNetCoreOpenApiVersion)" />
    <!-- ASP.NET Core 10 Blazor requires IInvocationBinder.GetTarget(ReadOnlySpan<byte>);
         SignalR 11 falls back to netstandard2.0 and aborts interactive circuits. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
    <!-- GHSA-334f-vvp4-7g6p: patched Common for consumers with CentralPackageTransitivePinningEnabled=true. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Common" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="11.0.0" />
