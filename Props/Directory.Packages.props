<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    <HexalithVersionsLoaded>true</HexalithVersionsLoaded>
    <!-- Central audit policy: low/moderate advisories remain warnings; high/critical and unavailable audits fail. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;CS0618</WarningsNotAsErrors>
    <!-- Aspire 17 deprecates Aspire.AppHost.Sdk (ASPIRE012) and AddProject (CS0618).
         Existing AppHosts keep that SDK and AddProject during staged migration. -->
    <SuppressAspireAppHostSdkObsoleteWarning>true</SuppressAspireAppHostSdkObsoleteWarning>
    <!-- The supplied Works wrapper declares these three items after importing this catalog.
         Defer only for its normal wrapper; an explicit alternate catalog keeps our defaults. -->
    <_HexalithWorksOwnsMSBuildPackageVersions>false</_HexalithWorksOwnsMSBuildPackageVersions>
    <_HexalithNearestPackageProps>$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildProjectDirectory)'))</_HexalithNearestPackageProps>
    <_HexalithNearestPackageOwner Condition="'$(_HexalithNearestPackageProps)' != ''">$([System.IO.Path]::GetDirectoryName('$(_HexalithNearestPackageProps)'))</_HexalithNearestPackageOwner>
    <_HexalithSelectedPackageProps Condition="'$(DirectoryPackagesPropsPath)' != ''">$([MSBuild]::NormalizePath('$(DirectoryPackagesPropsPath)'))</_HexalithSelectedPackageProps>
    <_HexalithWorksOwnsMSBuildPackageVersions Condition="'$(DirectoryPackagesPropsPath)' != '' and '$(_HexalithSelectedPackageProps)' == '$(_HexalithNearestPackageProps)' and Exists('$(_HexalithNearestPackageOwner)/Hexalith.Works.slnx')">true</_HexalithWorksOwnsMSBuildPackageVersions>
    <HexalithCommonsVersion Condition="'$(HexalithCommonsVersion)' == ''">3.0.2</HexalithCommonsVersion>
    <HexalithConversationsVersion Condition="'$(HexalithConversationsVersion)' == ''">2.1.0</HexalithConversationsVersion>
    <HexalithPolymorphicSerializationsVersion Condition="'$(HexalithPolymorphicSerializationsVersion)' == ''">2.0.1</HexalithPolymorphicSerializationsVersion>
    <HexalithImmutableVersion>11.0.0</HexalithImmutableVersion>
    <HexalithAspNetCoreJwtBearerVersion>11.0.0</HexalithAspNetCoreJwtBearerVersion>
    <HexalithAspNetCoreMvcTestingVersion>11.0.0</HexalithAspNetCoreMvcTestingVersion>
    <HexalithAspNetCoreTestHostVersion>11.0.0</HexalithAspNetCoreTestHostVersion>
    <HexalithAspNetCoreOpenIdConnectVersion>11.0.0</HexalithAspNetCoreOpenIdConnectVersion>
    <_HexalithSelectCatalogEventStore Condition="'$(HexalithEventStoreVersion)' == ''">true</_HexalithSelectCatalogEventStore>
    <HexalithEventStoreVersion Condition="'$(HexalithEventStoreVersion)' == ''">5.4.0</HexalithEventStoreVersion>
    <HexalithCatalogEventStoreVersion Condition="'$(_HexalithSelectCatalogEventStore)' == 'true'">$(HexalithEventStoreVersion)</HexalithCatalogEventStoreVersion>
    <HexalithAspNetCoreOpenApiVersion>11.0.0</HexalithAspNetCoreOpenApiVersion>
    <HexalithOpenApiVersion>3.11.1</HexalithOpenApiVersion>
    <HexalithFrontComposerVersion Condition="'$(HexalithFrontComposerVersion)' == ''">6.0.1</HexalithFrontComposerVersion>
    <HexalithFoldersVersion Condition="'$(HexalithFoldersVersion)' == ''">2.0.1</HexalithFoldersVersion>
    <HexalithMcpCliVersion Condition="'$(HexalithMcpCliVersion)' == ''">3.0.0</HexalithMcpCliVersion>
    <HexalithMemoriesVersion Condition="'$(HexalithMemoriesVersion)' == ''">4.1.0</HexalithMemoriesVersion>
    <HexalithTenantsVersion Condition="'$(HexalithTenantsVersion)' == ''">8.0.4</HexalithTenantsVersion>
    <HexalithPartiesVersion Condition="'$(HexalithPartiesVersion)' == ''">4.0.1</HexalithPartiesVersion>
    <HexalithPartiesAspireVersion Condition="'$(HexalithPartiesAspireVersion)' == ''">4.0.1</HexalithPartiesAspireVersion>
    <HexalithProjectsVersion Condition="'$(HexalithProjectsVersion)' == ''">2.0.0</HexalithProjectsVersion>
    <HexalithAspireHostingDaprVersion>17.0.0-preview.1.261120-0454</HexalithAspireHostingDaprVersion>
    <HexalithAspireAppHostSdkVersion>17.0.0</HexalithAspireAppHostSdkVersion>
    <HexalithDaprRuntimeVersion>1.19.2</HexalithDaprRuntimeVersion>
    <HexalithDaprCliVersion>1.19.1</HexalithDaprCliVersion>
    <HexalithRedisImage>docker.io/library/redis</HexalithRedisImage>
    <HexalithRedisImageTag>7.4-alpine</HexalithRedisImageTag>
    <HexalithRedisImageDigest>sha256:ff02b58f971e7d7d156a1267e283fcbbeee91773b6aa36c49dac28ecfe28eadf</HexalithRedisImageDigest>
    <HexalithChatbotVersion Condition="'$(HexalithChatbotVersion)' == ''">1.83.0</HexalithChatbotVersion>
  </PropertyGroup>
