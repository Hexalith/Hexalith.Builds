    <!-- Prefer the stable validation implementation over preview transitive dependencies. -->
    <PackageVersion Include="Microsoft.Extensions.Validation" Version="11.0.0" />
    <!-- FrontComposer Story 2-4: deterministic TimeProvider-based threshold tests. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
