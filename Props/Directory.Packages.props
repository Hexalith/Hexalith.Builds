    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <!-- FrontComposer Roslyn tooling must remain compatible with the compiler host pinned by global.json (SDK 11.0.100 ships 5.12.0). -->
