    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.21.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <!-- Prerelease accepted explicitly per Hexalith.Memories ADR-8.5-001 (b); upgrade-on-GA trigger tracked in Memories deferred-work.md. -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.21.0-beta.1" />
    <PackageVersion Include="OrchardCore.Localization.Core" Version="3.0.1" />
    <!-- FrontComposer Story 10-3: file-based EventStore REST consumer contracts. -->
    <PackageVersion Include="PactNet" Version="5.0.1" />
    <PackageVersion Include="Radzen.Blazor" Version="13.1.1" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Scriban" Version="7.6.1" />
    <PackageVersion Include="SendGrid" Version="9.29.3" />
    <PackageVersion Include="SendGrid.Extensions.DependencyInjection" Version="1.0.1" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Process" Version="3.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.37.0.15768" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="11.0.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
    <PackageVersion Include="System.Collections.Immutable" Version="$(HexalithImmutableVersion)" />
    <!-- Microsoft-supported CLI parser chosen per Hexalith.Memories ADR-7.1-008: recursive/global options, async handlers with CancellationToken, global-tool packaging. -->
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <!-- FrontComposer FcShellOptions data-annotation validation on netstandard2.0. -->
    <PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <!-- OpenTelemetry 1.21 supports net10.0 and requires DiagnosticSource 11 at runtime. -->
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="11.0.0" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="11.0.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <!-- FrontComposer Story 3-5 D5: BadgeCountService observable isolation. -->
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
    <PackageVersion Include="System.Text.Json" Version="11.0.0" />
    <!-- FrontComposer Story 3-5 D3: ValueTask<T> contracts on netstandard2.0. -->
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <PackageVersion Include="Testcontainers" Version="4.17.0" />
    <PackageVersion Include="Threenine.Data" Version="5.0.1" />
    <!-- FrontComposer snapshot testing uses the xUnit v3 adapter, not Verify.Xunit. -->
    <PackageVersion Include="Verify" Version="33.6.0" />
    <PackageVersion Include="Verify.XunitV3" Version="33.6.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="bunit" Version="2.15.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.3" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.3" />
  </ItemGroup>
  <!-- Metadata-only catalog copies do not require build-time analyzer selection. -->
  <Import Project="$(MSBuildThisFileDirectory)Logging.Build.targets" Condition="Exists('$(MSBuildThisFileDirectory)Logging.Build.targets')" />
  <Import Project="$(MSBuildThisFileDirectory)AspireAppHost.Build.targets" Condition="Exists('$(MSBuildThisFileDirectory)AspireAppHost.Build.targets')" />
  <Target Name="ValidateHexalithFramework" BeforeTargets="PrepareForBuild">
    <Error Condition="!$(NETCoreSdkVersion.StartsWith('11.0.')) or !(('$(TargetFrameworkIdentifier)' == '.NETCoreApp' and '$(TargetFrameworkVersion)' == 'v11.0') or (('$(IsRoslynComponent)' == 'true' or $([System.String]::Copy(';$(TargetFrameworks);').Contains(';net11.0;'))) and '$(TargetFrameworkIdentifier)' == '.NETStandard' and '$(TargetFrameworkVersion)' == 'v2.0'))"
           Text="$(MSBuildProjectName) requires the .NET 11 SDK and a net11.0 target. Selected SDK $(NETCoreSdkVersion), framework $(TargetFramework)." />
  </Target>
  <Target Name="ValidateHexalithEventStoreSelection" BeforeTargets="CollectPackageReferences" Condition="'$(ManagePackageVersionsCentrally)' == 'true'">
    <ItemGroup>
      <_HexalithEventStoreDependency Include="@(PackageReference)" Condition="$([System.String]::Copy('%(PackageReference.Identity)').StartsWith('Hexalith.EventStore.', System.StringComparison.OrdinalIgnoreCase))" />
      <_HexalithEventStoreRow Include="@(PackageVersion)" Condition="$([System.String]::Copy('%(PackageVersion.Identity)').StartsWith('Hexalith.EventStore.', System.StringComparison.OrdinalIgnoreCase))" />
    </ItemGroup>
    <Error Condition="'@(_HexalithEventStoreDependency)' != '' and '%(_HexalithEventStoreRow.Version)' != '$(HexalithEventStoreVersion)'"
           Text="$(MSBuildProjectName) selects %(_HexalithEventStoreRow.Identity) %(_HexalithEventStoreRow.Version). Restore the selected EventStore version $(HexalithEventStoreVersion)." />
  </Target>
  <Target Name="ValidateHexalithEventStoreReferences" AfterTargets="ResolveReferences"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_HexalithResolvedEventStore Include="@(ReferencePath)" Condition="$([System.String]::Copy('%(ReferencePath.NuGetPackageId)').StartsWith('Hexalith.EventStore.', System.StringComparison.OrdinalIgnoreCase))" />
    </ItemGroup>
    <Error Condition="'@(_HexalithResolvedEventStore)' != '' and '%(_HexalithResolvedEventStore.NuGetPackageVersion)' != '$(HexalithEventStoreVersion)'"
           Text="$(MSBuildProjectName) resolved %(_HexalithResolvedEventStore.NuGetPackageId) %(_HexalithResolvedEventStore.NuGetPackageVersion). The Builds catalog requires $(HexalithEventStoreVersion)." />
  </Target>
</Project>
