    <PackageVersion Include="Microsoft.Bot.Builder" Version="4.23.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0" />
    <!-- MSBuild 18.12 targets .NET 11, matching the tooling and SDK host. -->
    <PackageVersion Include="Microsoft.Build" Version="18.12.2" Condition="'$(_HexalithWorksOwnsMSBuildPackageVersions)' != 'true'" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.12.2" Condition="'$(_HexalithWorksOwnsMSBuildPackageVersions)' != 'true'" />
