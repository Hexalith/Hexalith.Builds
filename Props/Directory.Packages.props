    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <!-- FrontComposer MCP server runtime. -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Moq.Contrib.HttpClient" Version="1.4.0" />
    <PackageVersion Include="NBomber" Version="6.7.1" />
    <PackageVersion Include="NBomber.Http" Version="6.2.1" />
    <!-- Maintained NetArchTest fork (same NetArchTest.Rules API); 1.4.5 brings Mono.Cecil 0.11.6 which parses net10.0 IL. -->
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
    <PackageVersion Include="NFalkorDB" Version="1.2.0" />
    <PackageVersion Include="NRedisStack" Version="1.8.0" />
