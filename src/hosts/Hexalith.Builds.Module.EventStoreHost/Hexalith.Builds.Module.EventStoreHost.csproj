<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>Hexalith.Builds.Module.EventStoreHost</AssemblyName>
    <RootNamespace>Hexalith.Builds.ModuleHosts.EventStoreHost</RootNamespace>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <Description>Builds-owned EventStore composition root over the Hexalith.EventStore.Gateway package for G-4 runs.</Description>
    <BuildsCatalogFromMappedSource Condition="'$(Configuration)' == 'Debug' and Exists('$(HexalithEventStoreRoot)/src/Hexalith.EventStore.Gateway/Hexalith.EventStore.Gateway.csproj')">true</BuildsCatalogFromMappedSource>
    <DefineConstants Condition="'$(BuildsCatalogFromMappedSource)' == 'true'">$(DefineConstants);HEXALITH_EVENTSTORE_MAPPED_SOURCE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Hexalith.EventStore.Gateway" Condition="'$(BuildsCatalogFromMappedSource)' != 'true'" />
    <ProjectReference Include="$(HexalithEventStoreRoot)/src/Hexalith.EventStore.Gateway/Hexalith.EventStore.Gateway.csproj" Condition="'$(BuildsCatalogFromMappedSource)' == 'true'" />
    <InternalsVisibleTo Include="Hexalith.Platform.Composition.Tests" />
  </ItemGroup>
  <!-- Resolve the actual Gateway package, including central and direct overrides, before enabling this public API. -->
  <Target Name="SelectPublicTechnicalHttpReceiver" BeforeTargets="CoreCompile" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_BuildsResolvedGateway Include="@(ReferencePath->WithMetadataValue('NuGetPackageId', 'Hexalith.EventStore.Gateway'))" />
    </ItemGroup>
    <PropertyGroup>
      <BuildsPublicTechnicalHttpReceiver>false</BuildsPublicTechnicalHttpReceiver>
      <BuildsPublicTechnicalHttpReceiver Condition="'$(BuildsCatalogFromMappedSource)' != 'true' and '@(_BuildsResolvedGateway->Count())' == '1' and ('%(_BuildsResolvedGateway.NuGetPackageVersion)' == '4.0.4' or '%(_BuildsResolvedGateway.NuGetPackageVersion)' == '4.1.0' or '%(_BuildsResolvedGateway.NuGetPackageVersion)' == '4.2.0')">true</BuildsPublicTechnicalHttpReceiver>
      <DefineConstants Condition="'$(BuildsPublicTechnicalHttpReceiver)' == 'true'">$(DefineConstants);HEXALITH_EVENTSTORE_PUBLIC_TECHNICAL_RECEIVER</DefineConstants>
    </PropertyGroup>
  </Target>
</Project>
