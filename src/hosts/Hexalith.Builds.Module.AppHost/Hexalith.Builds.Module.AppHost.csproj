<Project>
  <Import Project="../../../Props/Directory.Packages.props" />
  <Import Project="Sdk.props" Sdk="Aspire.AppHost.Sdk" Version="$(HexalithAspireAppHostSdkVersion)" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Hexalith.Builds.Module.AppHost</AssemblyName>
    <RootNamespace>Hexalith.Builds.ModuleHosts.AppHost</RootNamespace>
    <Description>Builds-owned Aspire AppHost that composes one G-4 run from a runner-written run plan.</Description>
    <!-- CommunityToolkit.Aspire.Hosting.Dapr and the EventStore Aspire extensions are prerelease-only integrations. -->
    <NoWarn>$(NoWarn);NU5104;ASPIRE010;CA1303</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Dapr" />
    <!-- Align published EventStore transitive hosting dependencies with the approved catalog; Keycloak runtime remains unqualified. -->
    <PackageReference Include="Aspire.Hosting.Keycloak" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="Hexalith.EventStore.Aspire" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Hexalith.Builds.Module.EventStoreHost/Hexalith.Builds.Module.EventStoreHost.csproj" />
    <ProjectReference Include="../Hexalith.Builds.Module.UiHost/Hexalith.Builds.Module.UiHost.csproj" />
    <ProjectReference Include="../../libraries/Hexalith.Builds.Tooling/Hexalith.Builds.Tooling.csproj" IsAspireProjectResource="false" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Aspire.AppHost.Sdk" Version="$(HexalithAspireAppHostSdkVersion)" />
</Project>
